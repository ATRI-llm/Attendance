generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PRINCIPAL
}

enum FaceStatus {
  NOT_ADDED
  PENDING
  ADDED
  RESCAN
}

enum AttendanceSessionStatus {
  PENDING
  PROCESSED
  FINALIZED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  MANUAL
}

enum MealSessionStatus {
  PENDING
  PROCESSED
  CONFIRMED
}

enum GeofenceValidationType {
  ATTENDANCE
  FACE_ONBOARDING
  MEAL_COUNT
}

enum FaceOnboardingSessionStatus {
  PENDING
  IMAGES_CAPTURED
  PROCESSING
  COMPLETED
  FAILED
}

enum MlJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MlJobType {
  FACE_EMBEDDING_GENERATION
  ATTENDANCE_PROCESSING
  MEAL_COUNT_PROCESSING
  TRAIN_CLASSIFIER
}

model User {
  id       String @id @default(uuid())
  userCode String @unique

  firstName String
  lastName  String

  role         Role
  mobileNumber String
  email        String? @unique
  passwordHash String
  status       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student?
  teacher Teacher?

  attendanceSessions AttendanceSession[] @relation("TeacherAttendanceSessions")

  mealSessions          MealSession[]           @relation("TeacherMealSessions")
  geofenceValidations   GeofenceValidation[]
  FaceOnboardingSession FaceOnboardingSession[]
}

model School {
  id      String @id @default(uuid())
  name    String
  address String

  district String?
  state    String?
  pinCode  String?

  contactNumber String?

  latitude  Float
  longitude Float
  geoRadius Float

  isActive Boolean @default(true)

  standards           Standard[]
  geofenceValidations GeofenceValidation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Standard {
  id    String @id @default(uuid())
  value Int

  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  sections Section[]

  @@unique([schoolId, value])
}

model Section {
  id   String @id @default(uuid())
  name String

  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  standardId String

  students Student[]

  teachers TeacherSection[]

  attendanceSessions AttendanceSession[]

  mealSessions          MealSession[]
  FaceOnboardingSession FaceOnboardingSession[]
  modelAssets           ModelAsset[]

  @@unique([standardId, name])
}

model Student {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  rollNumber Int

  dateOfBirth DateTime?

  profileImage String?

  faceImages StudentFaceImage[]

  attendanceRecords AttendanceRecord[]

  faceStatus FaceStatus @default(NOT_ADDED)

  faceEmbeddings StudentFaceEmbedding[]

  cropImages AttendanceCropImage[]

  createdAt             DateTime                @default(now())
  FaceOnboardingSession FaceOnboardingSession[]

  @@unique([sectionId, rollNumber])
  @@index([sectionId])
}

model StudentFaceImage {
  id String @id @default(uuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  onboardingSessionId String?

  onboardingSession FaceOnboardingSession? @relation(fields: [onboardingSessionId], references: [id])

  imageUrl String

  fileSize Int?

  mimeType String?

  createdAt DateTime @default(now())
}

model AttendanceImage {
  id String @id @default(uuid())

  attendanceSessionId String

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  imageUrl String

  fileSize Int?

  mimeType String?

  createdAt DateTime @default(now())
}


model MealImage {
  id String @id @default(uuid())

  mealSessionId String

  mealSession MealSession @relation(fields: [mealSessionId], references: [id], onDelete: Cascade)

  imageUrl String

  fileSize Int?

  mimeType String?

  createdAt DateTime @default(now())
}

model StudentFaceEmbedding {
  id String @id @default(uuid())

  studentId String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  embedding Json

  modelVersion String?

  createdAt DateTime @default(now())

  @@index([studentId])
}

model Teacher {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  sections TeacherSection[]
}

model TeacherSection {
  id String @id @default(uuid())

  teacher   Teacher @relation(fields: [teacherId], references: [id])
  teacherId String

  section   Section @relation(fields: [sectionId], references: [id])
  sectionId String

  @@unique([teacherId, sectionId])
  @@index([teacherId])
  @@index([sectionId])
}

model AttendanceSession {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  teacherUserId String
  teacherUser   User   @relation("TeacherAttendanceSessions", fields: [teacherUserId], references: [id])

  date DateTime

  status AttendanceSessionStatus @default(PENDING)

  confidenceScore Float?

  // Offline attendance metadata
  isOfflineSync     Boolean @default(false)  // true if submitted from mobile offline
  deviceId          String?                  // device that captured the attendance
  backboneVersion   String?                  // MobileFaceNet version used
  classifierVersion String?                  // NN classifier version used

  createdAt DateTime @default(now())

  records    AttendanceRecord[]
  images     AttendanceImage[]
  mlJobs     MlProcessingJob[]
  cropImages AttendanceCropImage[]

  @@unique([sectionId, date])
  @@index([teacherUserId])
  @@index([sectionId])
}

model AttendanceRecord {
  id String @id @default(uuid())

  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  status AttendanceStatus

  confidenceScore Float?

  isManualOverride Boolean @default(false)

  markedAt DateTime @default(now())

  // On-device inference metadata (offline attendance)
  cropImageUrl      String?  // S3 URL of the face crop from the group photo
  embeddingVector   Json?    // 512-dim MobileFaceNet embedding — used for NN retraining
  backboneVersion   String?  // MobileFaceNet model version used at inference
  classifierVersion String?  // NN classifier version used at inference

  @@index([attendanceSessionId])
  @@index([studentId])
}

model MealSession {
  id String @id @default(uuid())

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  teacherUserId String
  teacherUser   User   @relation("TeacherMealSessions", fields: [teacherUserId], references: [id])

  date DateTime

  totalDetected Int

  confidenceScore Float?

  status MealSessionStatus @default(PENDING)

  mlJobs MlProcessingJob[]

  images MealImage[]

  // Offline meal metadata
  isOfflineSync     Boolean @default(false)
  deviceId          String?
  detectorVersion   String?

  createdAt DateTime @default(now())

  @@unique([sectionId, date])
}

model GeofenceValidation {
  id String @id @default(uuid())

  teacherUserId String

  teacherUser User @relation(fields: [teacherUserId], references: [id])

  validationType GeofenceValidationType

  referenceId String?

  latitude  Float
  longitude Float

  distance Float

  isWithinGeofence Boolean

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  validatedAt DateTime @default(now())

  @@index([teacherUserId])
  @@index([validationType])
  @@index([referenceId])
}

model FaceOnboardingSession {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  teacherUserId String
  teacherUser   User   @relation(fields: [teacherUserId], references: [id])

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  status FaceOnboardingSessionStatus @default(PENDING)

  totalImages Int @default(0)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images StudentFaceImage[]

  mlJobs MlProcessingJob[]
}

model MlProcessingJob {
  id String @id @default(uuid())

  onboardingSessionId String?

  onboardingSession FaceOnboardingSession? @relation(fields: [onboardingSessionId], references: [id])

  attendanceSessionId String?

  attendanceSession AttendanceSession? @relation(fields: [attendanceSessionId], references: [id])

  mealSessionId String?

  mealSession MealSession? @relation(fields: [mealSessionId], references: [id])

  sectionId String?

  status MlJobStatus @default(PENDING)

  jobType MlJobType

  responsePayload Json?

  errorMessage String?

  startedAt DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────
// AttendanceCropImage
// Stores face crops captured during offline attendance.
// crop photo + 512-dim embedding + confirmed student label =
// one training sample for the next Neural Network retraining cycle.
// ─────────────────────────────────────────────────────────────────
model AttendanceCropImage {
  id String @id @default(uuid())

  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])

  imageUrl String  // S3 URL of the face crop

  // 512-dim MobileFaceNet embedding of this crop.
  // This is the feature vector the next NN training cycle will use as input.
  // Note: classifier output (40-dim) is NOT stored — it is ephemeral.
  embeddingVector Json

  backboneVersion String  // which MobileFaceNet version extracted this embedding

  isVerified Boolean @default(false)  // true after teacher confirms the student label

  capturedAt DateTime

  createdAt DateTime @default(now())

  @@index([attendanceSessionId])
  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────
// ModelAsset
// Registry of all backbone + classifier model versions.
// Mobile app checks this to know if a newer model is available.
// Teacher app downloads and caches locally for offline inference.
// ─────────────────────────────────────────────────────────────────
model ModelAsset {
  id String @id @default(uuid())

  // Human-readable names / versions
  backboneVersion   String  // e.g. "MobileFaceNet-v1"
  classifierVersion String  // e.g. "nn-classifier-v2"

  // The section this classifier was trained for (NN is per-section)
  sectionId String
  section   Section @relation(fields: [sectionId], references: [id])

  // Download URLs for mobile app
  backboneUrl   String  // S3 URL for the backbone model file
  classifierUrl String  // S3 URL for the classifier model file

  isActive Boolean @default(false)  // only one active per section at a time

  // Metadata for tracking
  trainedAt   DateTime  // when this model was trained
  description String?   // e.g. "Trained on 200 crops, June 2026 batch"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@index([sectionId, isActive])
}


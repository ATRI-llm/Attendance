# Ignore everything by default (allow-list approach is sometimes safer, but we'll just ignore the big ones globally)

# Node
**/node_modules
**/.next
**/dist

# Python
**/.venv
**/venv
**/env
**/__pycache__
**/*.pyc
**/*.pyo
**/*.egg-info
**/.pytest_cache

# Large ML / Data
**/dataset
**/output
**/artifacts
**/*.pth
**/*.pt
**/*.npy
**/*.csv
**/requirements_locked.txt

# Old / unused huge folders
apps/face_attendance
apps/mobile-teacher
apps/backend/uploads

# Environment / Logs
**/.env
**/*.log
**/npm-debug.log*

# Git
**/.git
**/.gitignore

# Mac
**/.DS_Store

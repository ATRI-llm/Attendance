# Copy to .env and replace every placeholder marked below.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_database_password
POSTGRES_DB=school_db

# Backend JWT signing secret: use a long random value (32+ characters).
JWT_SECRET=replace_with_a_long_random_jwt_secret_at_least_32_characters

# Internal backend <-> ML worker/service authentication.
BACKEND_TOKEN=replace_with_a_long_random_internal_service_token

# Public HTTP origin reachable by teacher/student devices.
# On a LAN this should usually be something like:
# http://192.168.1.50:5000
PUBLIC_BASE_URL=http://localhost:5000

# Browser-facing API URL for the Next.js admin app.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Face matching threshold used by the ML attendance endpoint.
FACE_MATCH_THRESHOLD=0.55

# Worker tuning.
WORKER_CONCURRENCY=2
TRAINING_POLL_INTERVAL_MS=5000
TRAINING_MAX_POLLS=120

# Local storage fallback.
USE_LOCAL_UPLOAD=true
LOCAL_UPLOAD_BASE_URL=http://localhost:5000

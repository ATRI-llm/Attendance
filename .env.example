# Copy this file to .env and fill in the values before running docker compose up

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Kkr@13245
POSTGRES_DB=school_db

# ── JWT ─────────────────────────────────────────────────────────
JWT_SECRET=change_me_in_production

# ── Local File Storage ───────────────────────────────────────────
# Base URL where files in /uploads are served publicly
LOCAL_UPLOAD_BASE_URL=http://localhost:5000

# ── Admin token for model registration ──────────────────────────
# Get this by logging in as ADM_001 via POST /api/auth/login
BACKEND_TOKEN=

